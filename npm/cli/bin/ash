#!/usr/bin/env bash
# ash — AnotherSkillHub CLI（npm 包装版）
# 核心逻辑始终来自服务端 /cli.sh，保证行为与部署实例一致；本包装只负责记住服务地址并拉取/更新脚本。
#   首次使用：ash config https://your-hub.example.com   （或设置环境变量 ASH_SERVER_URL）
set -euo pipefail
CONFIG_FILE="$HOME/.ash/server"

if [ "${1:-}" = "config" ]; then
  [ -n "${2:-}" ] || { echo "用法: ash config <服务地址>，例如 ash config https://your-hub.example.com" >&2; exit 1; }
  mkdir -p "$HOME/.ash"
  printf '%s\n' "${2%/}" > "$CONFIG_FILE"
  rm -f "$HOME/.ash/cli.sh"
  echo "✅ 已设置服务地址: ${2%/}"
  exit 0
fi

SERVER_URL="${ASH_SERVER_URL:-$(cat "$CONFIG_FILE" 2>/dev/null || true)}"
if [ -z "$SERVER_URL" ]; then
  echo "错误: 尚未配置 AnotherSkillHub 服务地址。请执行 ash config <服务地址>，或设置环境变量 ASH_SERVER_URL。" >&2
  exit 1
fi
export ASH_SERVER_URL="$SERVER_URL"

if [ ! -f "$HOME/.ash/cli.sh" ] || [ "${1:-}" = "update" ] || [ "${ASH_ALWAYS_FETCH:-}" = "1" ]; then
  mkdir -p "$HOME/.ash"
  curl -fsSL "$SERVER_URL/cli.sh" -o "$HOME/.ash/cli.sh"
  chmod +x "$HOME/.ash/cli.sh"
fi
if [ "${1:-}" = "update" ]; then
  echo "✅ ash 已更新到最新版本（来源: $SERVER_URL/cli.sh）"
  exit 0
fi
exec bash "$HOME/.ash/cli.sh" "$@"
