import { useEffect, useRef } from 'react';

// 单一快捷键注册表：所有全局键位都从一张表驱动，速查面板（?）直接由同一张表生成，
// 避免键位散落在各组件的 keydown 里、说明与实现对不上。
//
// 绑定形如 { id, keys: 'mod+k' | ['j', 'ArrowDown'], label, group, run, allowInInput, hidden }
//   mod   = ⌘（macOS）/ Ctrl（其他平台）
//   keys  为数组时任一命中即可（j / ↓ 这类同义键）
//   allowInInput 为真时，在输入框里也生效（⌘S、Esc 这类）

const IS_MAC = typeof navigator !== 'undefined' && /mac/i.test(navigator.platform || navigator.userAgent);

// 需要 Shift 才能打出的字符：按下时 shiftKey 必为真，不能再要求「无 Shift」
const SHIFTED_CHARS = /^[?!@#$%^&*()_+{}|:"<>~]$/;

export function isTypingTarget(target) {
  if (!target || typeof target.tagName !== 'string') return false;
  if (target.isContentEditable) return true;
  return ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName);
}

function matchesSpec(spec, event) {
  const parts = spec.split('+');
  const key = parts[parts.length - 1];
  const wantMod = parts.includes('mod');
  const wantShift = parts.includes('shift') || SHIFTED_CHARS.test(key);
  const wantAlt = parts.includes('alt');
  const hasMod = event.metaKey || event.ctrlKey;
  if (wantMod !== hasMod) return false;
  if (wantShift !== event.shiftKey) return false;
  if (wantAlt !== event.altKey) return false;
  if (key.length === 1) return (event.key || '').toLowerCase() === key.toLowerCase();
  return (event.key || '').toLowerCase() === key.toLowerCase();
}

export function matchesBinding(binding, event) {
  const specs = Array.isArray(binding.keys) ? binding.keys : [binding.keys];
  return specs.some((spec) => matchesSpec(spec, event));
}

// 键位的可读写法，供速查面板与菜单项提示复用
export function formatKeys(keys) {
  const spec = Array.isArray(keys) ? keys[0] : keys;
  const names = {
    mod: IS_MAC ? '⌘' : 'Ctrl',
    shift: '⇧',
    alt: IS_MAC ? '⌥' : 'Alt',
    arrowup: '↑',
    arrowdown: '↓',
    arrowleft: '←',
    arrowright: '→',
    enter: '↵',
    escape: 'Esc',
    delete: 'Del',
    backspace: '⌫',
    ' ': 'Space',
  };
  return spec
    .split('+')
    .map((part) => names[part.toLowerCase()] || (part.length === 1 ? part.toUpperCase() : part))
    .join(IS_MAC ? '' : '+');
}

export default function useHotkeys(bindings) {
  // ref 保存最新绑定，避免每次 render 重新挂/卸监听
  const bindingsRef = useRef(bindings);
  bindingsRef.current = bindings;

  useEffect(() => {
    const onKeyDown = (event) => {
      if (event.defaultPrevented || event.isComposing) return;
      const typing = isTypingTarget(event.target);
      for (const binding of bindingsRef.current) {
        if (!binding || typeof binding.run !== 'function') continue;
        if (typing && !binding.allowInInput) continue;
        if (!matchesBinding(binding, event)) continue;
        event.preventDefault();
        binding.run(event);
        return;
      }
    };
    window.addEventListener('keydown', onKeyDown);
    return () => window.removeEventListener('keydown', onKeyDown);
  }, []);
}
